<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción cliente que renderiza el componente OWL del tablero -->
    <record id="action_repair_dashboard" model="ir.actions.client">
        <field name="name">Dashboard</field>
        <field name="tag">repair_dashboard</field>
    </record>

    <!-- El menú raíz del módulo Reparaciones abre el tablero por defecto -->
    <menuitem id="repair.menu_repair_order"
              action="action_repair_dashboard"
              name="Reparaciones"
              groups="stock.group_stock_user"
              sequence="165"
              web_icon="repair,static/description/icon.svg"/>

    <!-- Menú Dashboard: primer elemento del módulo -->
    <menuitem id="menu_repair_dashboard"
              name="Dashboard"
              parent="repair.menu_repair_order"
              action="action_repair_dashboard"
              sequence="1"
              groups="stock.group_stock_user"/>

    <!-- Acceso a la lista de órdenes de reparación -->
    <menuitem id="menu_repair_orders_list"
              name="Órdenes de Reparación"
              parent="repair.menu_repair_order"
              action="repair.action_repair_order_tree"
              sequence="2"
              groups="stock.group_stock_user"/>

</odoo>
